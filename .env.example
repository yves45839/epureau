# Mode de développement sur un seul ordinateur. NE PAS activer sur Netlify/Vercel.
ADMIN_LOCAL_STORE=0
ADMIN_EMAIL=admin@epureau-ci.com
ADMIN_PASSWORD=
# Adresses super administrateur, séparées par des virgules (propriétaires du site).
ADMIN_SUPER_EMAILS=roland@label-ci.com

# Supabase Free : chaîne PostgreSQL du pooler, uniquement côté serveur.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Ancienne clé service_role, facultative si SUPABASE_SECRET_KEY est renseignée.
SUPABASE_SERVICE_ROLE_KEY=

# Facultatif : notifications e-mail, limitées au quota du forfait gratuit choisi.
RESEND_API_KEY=
MAIL_FROM="EPUREAU Côte d’Ivoire <contact@epureau-ci.com>"
